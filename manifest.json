{
  "manifest_version": 3,
  "name": "Tab Audio Recorder",
  "version": "1.2",
  "description": "Record the current tab's audio to a .m4a file, and mute or unmute what you hear at any time without affecting the recording.",
  "minimum_chrome_version": "126",
  "permissions": ["tabCapture", "offscreen", "downloads", "activeTab", "storage"],
  "background": { "service_worker": "src/background/index.js", "type": "module" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tab Audio Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "commands": {
    "toggle-hear": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Mute or unmute what you hear (recording continues)"
    }
  }
}
